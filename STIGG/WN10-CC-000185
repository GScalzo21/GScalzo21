<#
.SYNOPSIS
    This PowerShell script disables AutoRun commands to comply with STIG WN10-CC-000185.

.NOTES
    Author          : Giuseppe Scalzo
    LinkedIn        : https://www.linkedin.com/in/giuseppe-scalzo-/
    GitHub          : https://github.com/GScalzo21
    Date Created    : 2025-05-10
    Last Modified   : 2025-05-10
    Version         : 1.0
    STIG-ID         : WN10-CC-000185

.TESTED ON
    Date(s) Tested  : 2025-05-10
    Tested By       : Giuseppe Scalzo
    Systems Tested  : Windows 10 VM (lab)
    PowerShell Ver. : 5.1

.USAGE
    Run this script as Administrator to disable autorun command execution.
    Example:
    PS C:\> .\WN10-CC-000185_Disable-AutoRun.ps1
#>

# Define registry path and key
$registryPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
$valueName = "NoAutorun"
$valueData = 1

# Ensure registry path exists
if (-not (Test-Path $registryPath)) {
    New-Item -Path $registryPath -Force | Out-Null
}

# Set the registry key to disable AutoRun
Set-ItemProperty -Path $registryPath -Name $valueName -Value $valueData -Type DWord
Write-Host "AutoRun command execution disabled (NoAutorun = $valueData) at $registryPath"
